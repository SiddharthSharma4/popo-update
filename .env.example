# OSM Environment Configuration Example
# Copy this file to .env for local development

# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Local SQLite database path (relative or absolute)
DATABASE_URL=./data/osm.db

# Optional AI Configuration (Advisory Only)
# When unset or set to 'mock', the deterministic DEMO FALLBACK adapter is used
AI_PROVIDER=mock
AI_API_KEY=
